<Window x:Class="VoiceTyper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="VoiceTyper"
        Width="188"
        Height="56"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        FontFamily="Segoe UI Variable Display, Microsoft YaHei UI, Segoe UI">
  <Window.Resources>
    <!-- Ambient recording pulse: low amplitude, long period, soft opacity (Wispr-style HUD, not alarm). -->
    <Storyboard x:Key="PulseStory" RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="PulseRing"
                       Storyboard.TargetProperty="Opacity"
                       From="0.28" To="0.06" Duration="0:0:1.85"
                       AutoReverse="True">
        <DoubleAnimation.EasingFunction>
          <QuinticEase EasingMode="EaseInOut"/>
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="PulseScale"
                       Storyboard.TargetProperty="ScaleX"
                       From="1.0" To="1.06" Duration="0:0:1.85"
                       AutoReverse="True">
        <DoubleAnimation.EasingFunction>
          <QuinticEase EasingMode="EaseInOut"/>
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="PulseScale"
                       Storyboard.TargetProperty="ScaleY"
                       From="1.0" To="1.06" Duration="0:0:1.85"
                       AutoReverse="True">
        <DoubleAnimation.EasingFunction>
          <QuinticEase EasingMode="EaseInOut"/>
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>
    <Storyboard x:Key="ScanStory" RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="ScanRotate"
                       Storyboard.TargetProperty="Angle"
                       From="0" To="360" Duration="0:0:1.65"/>
    </Storyboard>

    <ContextMenu x:Key="TrayContextMenu">
      <MenuItem Header="显示窗口" Click="OnTrayShow"/>
      <MenuItem Header="设置" Click="OnOpenSettings"/>
      <Separator/>
      <MenuItem Header="退出" Click="OnTrayExit"/>
    </ContextMenu>
    <ContextMenu x:Key="CapsuleContextMenu">
      <MenuItem Header="显示窗口" Click="OnTrayShow"/>
      <MenuItem Header="设置" Click="OnOpenSettings"/>
      <Separator/>
      <MenuItem Header="退出" Click="OnTrayExit"/>
    </ContextMenu>
  </Window.Resources>

  <Grid>
    <tb:TaskbarIcon x:Name="TrayIcon"
                    Width="0"
                    Height="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    ToolTipText="VoiceTyper 语音转文字"
                    TrayMouseDoubleClick="OnTrayShow"
                    ContextMenu="{StaticResource TrayContextMenu}"/>

    <Border x:Name="Shell"
            Background="{DynamicResource PaperBrush}"
            BorderBrush="{DynamicResource RuleBrush}"
            BorderThickness="1"
            CornerRadius="28"
            SnapsToDevicePixels="True"
            MouseRightButtonUp="OnShellRightClick"
            RenderTransformOrigin="0.5,0.5">
      <Border.RenderTransform>
        <ScaleTransform x:Name="ShellScale" ScaleX="1" ScaleY="1"/>
      </Border.RenderTransform>
      <Grid>
        <Grid x:Name="CapsuleLayer"
              Cursor="Hand"
              MouseLeftButtonDown="OnCapsuleMouseDown"
              MouseMove="OnCapsuleMouseMove"
              MouseLeftButtonUp="OnCapsuleMouseUp">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Ellipse Width="12" Height="12" Margin="18,0,10,0" VerticalAlignment="Center"
                   Fill="{DynamicResource BrassBrush}" x:Name="CapsuleDot"/>
          <TextBlock x:Name="CapsuleLabel"
                     Grid.Column="1"
                     Text="说一句"
                     Foreground="{DynamicResource IvoryBrush}"
                     FontSize="15"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     Margin="0,0,18,0"/>
        </Grid>

        <Grid x:Name="PaperLayer"
              Opacity="0"
              IsHitTestVisible="False"
              Margin="16"
              MouseLeftButtonDown="OnPaperChromeMouseDown">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="108"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="2,2,2,8">
            <StackPanel>
              <TextBlock Text="V O I C E"
                         Foreground="{DynamicResource BrassBrush}"
                         FontSize="11"
                         FontWeight="Bold"/>
              <TextBlock Text="贴边说一句"
                         Foreground="{DynamicResource IvoryBrush}"
                         FontSize="20"
                         FontWeight="SemiBold"
                         Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
              <Button Style="{StaticResource GhostButton}"
                      ToolTip="设置"
                      Margin="0,0,4,0"
                      Click="OnOpenSettings">
                <Path Data="{StaticResource GearGeometry}"
                      Fill="{DynamicResource MutedBrush}"
                      Stretch="Uniform"
                      Width="15" Height="15"
                      SnapsToDevicePixels="False"/>
              </Button>
              <Button Style="{StaticResource GhostButton}"
                      Content="收成胶囊"
                      Click="OnCollapseClick"/>
            </StackPanel>
          </Grid>

          <Border Grid.Row="1" Height="1" Background="{DynamicResource RuleBrush}" Margin="2,0,2,12" Opacity="0.85"/>

          <Grid x:Name="MicRow" Grid.Row="2">
            <Ellipse x:Name="PulseRing"
                     Width="86" Height="86"
                     Stroke="{DynamicResource EmberBrush}"
                     StrokeThickness="2"
                     Opacity="0"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Top"
                     Margin="0,2,0,0"
                     RenderTransformOrigin="0.5,0.5">
              <Ellipse.RenderTransform>
                <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1"/>
              </Ellipse.RenderTransform>
            </Ellipse>
            <Path x:Name="ScanArc"
                  Data="M 20,4 A 16,16 0 0 1 36,20"
                  Stroke="{DynamicResource BrassBrush}"
                  StrokeThickness="2.4"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Width="44" Height="44"
                  Stretch="Uniform"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Margin="0,16,0,0"
                  Opacity="0"
                  RenderTransformOrigin="0.5,0.5"
                  IsHitTestVisible="False">
              <Path.RenderTransform>
                <RotateTransform x:Name="ScanRotate" Angle="0"/>
              </Path.RenderTransform>
            </Path>

            <Grid x:Name="SingleMicHost" VerticalAlignment="Top">
              <Ellipse x:Name="MicHalo"
                       Width="72" Height="72"
                       Fill="{DynamicResource HaloBrush}"
                       Stroke="{DynamicResource RuleBrush}"
                       StrokeThickness="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,8,0,0"/>
              <Button x:Name="MicButton"
                      Width="72" Height="72"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Margin="0,8,0,0"
                      Click="OnMicClick"
                      Cursor="Hand"
                      ToolTip="点麦克风开始，停顿后自动结束">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                      <Path x:Name="MicGlyph"
                            Data="{StaticResource MicGeometry}"
                            Fill="{DynamicResource OnHaloBrush}"
                            Stretch="Uniform"
                            Width="22" Height="22"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Grid>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </Grid>

            <Grid x:Name="DualMicHost"
                  Opacity="0"
                  IsHitTestVisible="False"
                  VerticalAlignment="Top">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Grid x:Name="NewSentenceSlot"
                    Grid.Column="0"
                    RenderTransformOrigin="0.5,0.35">
                <Grid.RenderTransform>
                  <TranslateTransform x:Name="NewSentenceShift" X="36"/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                  <RowDefinition Height="72"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Ellipse x:Name="NewSentenceHalo"
                         Width="56" Height="56"
                         Fill="{DynamicResource HaloBrush}"
                         Stroke="{DynamicResource RuleBrush}"
                         StrokeThickness="1"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
                <Button x:Name="NewSentenceButton"
                        Width="56" Height="56"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Click="OnNewSentenceClick"
                        Cursor="Hand"
                        ToolTip="清掉现在的字，重新说一句">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Grid Background="Transparent">
                        <Path Data="{StaticResource MicGeometry}"
                              Fill="{DynamicResource OnHaloBrush}"
                              Stretch="Uniform"
                              Width="18" Height="18"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                      </Grid>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
                <TextBlock Grid.Row="1"
                           Text="新开一句"
                           Foreground="{DynamicResource IvoryBrush}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
              </Grid>

              <Grid x:Name="ContinueSlot"
                    Grid.Column="1"
                    RenderTransformOrigin="0.5,0.35">
                <Grid.RenderTransform>
                  <TranslateTransform x:Name="ContinueShift" X="-36"/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                  <RowDefinition Height="72"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Ellipse x:Name="ContinueHalo"
                         Width="56" Height="56"
                         Fill="{DynamicResource HaloBrush}"
                         Stroke="{DynamicResource RuleBrush}"
                         StrokeThickness="1"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
                <Button x:Name="ContinueButton"
                        Width="56" Height="56"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Click="OnContinueClick"
                        Cursor="Hand"
                        ToolTip="接着往下说，字会接在后面">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Grid Background="Transparent">
                        <Path Data="{StaticResource MicGeometry}"
                              Fill="{DynamicResource OnHaloBrush}"
                              Stretch="Uniform"
                              Width="18" Height="18"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                      </Grid>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
                <TextBlock Grid.Row="1"
                           Text="继续说"
                           Foreground="{DynamicResource IvoryBrush}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
              </Grid>
            </Grid>
          </Grid>

          <Canvas x:Name="WaveCanvas"
                  Grid.Row="3"
                  Height="44"
                  Margin="4,4,4,2"
                  ClipToBounds="True">
            <Path x:Name="WavePath"
                  Stroke="{DynamicResource BrassBrush}"
                  StrokeThickness="1.6"
                  StrokeLineJoin="Round"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"/>
          </Canvas>

          <DockPanel Grid.Row="4" Margin="4,6,4,8">
            <TextBlock x:Name="TimerText"
                       Text="0:00"
                       Foreground="{DynamicResource BrassBrush}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Width="52"/>
            <TextBlock x:Name="StatusText"
                       Text="点麦克风开始 · 停顿后自动结束"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
          </DockPanel>

          <Border Grid.Row="5"
                  Background="{DynamicResource WellBrush}"
                  BorderBrush="{DynamicResource RuleBrush}"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="8">
            <Grid>
              <TextBox x:Name="TranscriptBox"
                       Style="{StaticResource TranscriptBoxStyle}"/>
              <TextBlock x:Name="PlaceholderText"
                         Text="转写会出现在这里，可改字。"
                         Foreground="{DynamicResource PlaceholderBrush}"
                         FontSize="13"
                         Margin="2,1,0,0"
                         IsHitTestVisible="False"/>
            </Grid>
          </Border>

          <DockPanel Grid.Row="6" Margin="2,10,2,2">
            <Button x:Name="DownloadButton"
                    DockPanel.Dock="Right"
                    Style="{StaticResource GhostButton}"
                    Content="下载模型"
                    Foreground="{DynamicResource BrassBrush}"
                    Click="OnDownloadClick"
                    Visibility="Collapsed"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="HintText"
                         Text="结果会复制到剪贴板，窗口先留着方便改"
                         Foreground="{DynamicResource MutedBrush}"
                         FontSize="11"
                         TextWrapping="Wrap"/>
              <TextBlock x:Name="HintSecondary"
                         Text="行为可在设置里改"
                         Foreground="{DynamicResource PlaceholderBrush}"
                         FontSize="10"
                         Margin="0,2,0,0"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>

          <!-- Corner grip: AllowsTransparency windows often lack OS edge resize. -->
          <Path x:Name="PaperResizeGrip"
                Grid.Row="6"
                Width="14" Height="14"
                Margin="0,0,2,2"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Stretch="Uniform"
                Fill="{DynamicResource BrassBrush}"
                Opacity="0.55"
                Cursor="SizeNWSE"
                ToolTip="拖动调整纸张大小"
                Data="M0,10 L10,0 L14,0 L14,4 L4,14 L0,14 Z"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
