<Window x:Class="VoiceTyper.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:VoiceTyper.Services"
        Title="VoiceTyper 设置"
        Width="440"
        Height="520"
        MinWidth="400"
        MinHeight="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Background="{DynamicResource PaperBrush}"
        FontFamily="Segoe UI Variable Display, Microsoft YaHei UI, Segoe UI"
        Loaded="OnLoaded"
        PreviewMouseWheel="OnWindowPreviewMouseWheel">
  <!-- Single elevated Paper surface + hairline section rhythm (Linear/Raycast prefs), no zebra slabs. -->
  <Window.Resources>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource QuietScrollBar}"/>
  </Window.Resources>

  <Grid Margin="24,20,18,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="120"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel x:Name="HeaderPanel" Grid.Row="0" Margin="0,0,6,16">
      <TextBlock Text="V O I C E T Y P E R"
                 Foreground="{DynamicResource BrassBrush}"
                 FontSize="11"
                 FontWeight="Bold"/>
      <TextBlock Text="设置"
                 Foreground="{DynamicResource IvoryBrush}"
                 FontSize="24"
                 FontWeight="SemiBold"
                 Margin="0,4,0,0"/>
      <TextBlock Text="改完点保存。重启后仍会记住。"
                 Foreground="{DynamicResource MutedBrush}"
                 FontSize="12"
                 Margin="0,6,0,0"/>
    </StackPanel>

    <ScrollViewer x:Name="SettingsScroll"
                  Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly"
                  IsDeferredScrollingEnabled="False"
                  Focusable="True"
                  Padding="0,0,6,0"
                  PreviewMouseWheel="OnScrollPreviewMouseWheel">
      <StackPanel x:Name="SettingsBody" Margin="0,0,8,4">

        <TextBlock Style="{StaticResource SettingsSectionLabel}" Text="基础行为"/>

        <TextBlock Style="{StaticResource SettingsFieldLabel}" Text="关闭窗口时"/>
        <ComboBox x:Name="CloseBehaviorBox" Style="{StaticResource SettingsComboBox}">
          <ComboBoxItem Content="退出程序" Tag="Exit"/>
          <ComboBoxItem Content="仅藏到托盘" Tag="Tray"/>
        </ComboBox>

        <CheckBox x:Name="ShowInTaskbarBox" Style="{StaticResource SettingsCheckBox}" Content="显示任务栏图标"/>
        <CheckBox x:Name="TopmostBox" Style="{StaticResource SettingsCheckBox}" Content="始终置顶"/>
        <CheckBox x:Name="CollapseOnDeactivateBox" Style="{StaticResource SettingsCheckBox}" Content="失焦时自动收成胶囊"/>
        <CheckBox x:Name="VadAutoStopBox" Style="{StaticResource SettingsCheckBox}" Content="静音约 1 秒自动停录"/>
        <CheckBox x:Name="AutoCopyBox" Style="{StaticResource SettingsCheckBox}" Content="转完自动进剪贴板"/>
        <CheckBox x:Name="CollapseAfterDoneBox" Style="{StaticResource SettingsCheckBox}" Content="转完后收成胶囊"/>
        <TextBlock Style="{StaticResource SettingsHint}"
                   Text="{x:Static svc:UiCopy.CollapseAfterDoneHint}"
                   Margin="0,0,0,8"/>

        <Border Height="1" Background="{DynamicResource RuleBrush}" Margin="0,8,0,16" Opacity="0.55"/>

        <TextBlock Style="{StaticResource SettingsSectionLabel}" Text="视觉"/>

        <TextBlock Style="{StaticResource SettingsFieldLabel}" Text="配色"/>
        <ComboBox x:Name="ColorThemeBox" Style="{StaticResource SettingsComboBox}" SelectionChanged="OnThemePreviewChanged">
          <ComboBoxItem Content="墨黑" Tag="InkBlack"/>
          <ComboBoxItem Content="暖纸" Tag="WarmPaper"/>
          <ComboBoxItem Content="冷灰" Tag="CoolGray"/>
          <ComboBoxItem Content="林绿" Tag="Forest"/>
        </ComboBox>

        <TextBlock Style="{StaticResource SettingsFieldLabel}" Text="胶囊贴边"/>
        <ComboBox x:Name="DockSideBox" Style="{StaticResource SettingsComboBox}">
          <ComboBoxItem Content="右边" Tag="Right"/>
          <ComboBoxItem Content="左边" Tag="Left"/>
        </ComboBox>

        <TextBlock Style="{StaticResource SettingsFieldLabel}" Text="纸张大小"/>
        <ComboBox x:Name="PaperSizeBox" Style="{StaticResource SettingsComboBox}">
          <ComboBoxItem Content="小（280×380）" Tag="Small"/>
          <ComboBoxItem Content="中（320×428，默认）" Tag="Medium"/>
          <ComboBoxItem Content="大（400×560）" Tag="Large"/>
          <ComboBoxItem Content="自定义（记住上次拖拽）" Tag="Custom"/>
        </ComboBox>
        <TextBlock Style="{StaticResource SettingsHint}"
                   Text="展开纸张后可拖右下角调整；收成胶囊后会记住尺寸。也可选预设。"
                   Margin="0,0,0,8"/>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2"
            BorderBrush="{DynamicResource RuleBrush}"
            BorderThickness="0,1,0,0"
            Opacity="1"
            Margin="0,12,6,0"
            Padding="0,14,0,0">
      <DockPanel LastChildFill="False">
        <Button x:Name="CancelButton"
                DockPanel.Dock="Right"
                Content="取消"
                Width="88"
                Height="34"
                Margin="8,0,0,0"
                Click="OnCancel"
                Background="Transparent"
                Foreground="{DynamicResource MutedBrush}"
                BorderBrush="{DynamicResource RuleBrush}"
                BorderThickness="1"
                Cursor="Hand">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </ControlTemplate>
          </Button.Template>
        </Button>
        <Button x:Name="SaveButton"
                DockPanel.Dock="Right"
                Content="保存"
                Width="88"
                Height="34"
                Click="OnSave"
                Background="{DynamicResource BrassBrush}"
                Foreground="{DynamicResource InkBrush}"
                BorderThickness="0"
                FontWeight="SemiBold"
                Cursor="Hand">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border Background="{TemplateBinding Background}"
                      CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </DockPanel>
    </Border>
  </Grid>
</Window>
